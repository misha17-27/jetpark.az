Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Daxili qovluqlara birbaşa giriş qadağandır.
    RewriteRule ^(includes|pages|data|storage)(/|$) - [F,L]
    RewriteRule ^config\.php$ - [F,L]
    RewriteRule ^\.(?!well-known/) - [F,L]

    # Köhnə WordPress-in serverdə qalmış PHP faylları (wp-login.php, xmlrpc.php, wp-includes/...) icra olunmur.
    RewriteRule ^(xmlrpc\.php|wp-[a-z-]+\.php|wp-(admin|includes|content)/.+\.php)$ - [G,L]

    # www → www-suz (əvvəl bunu WordPress edirdi).
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # http → https-i Cloudflare özü edir. Cloudflare-siz hostinqdə şərhdən çıxarın
    # (Cloudflare "Flexible SSL" rejimində bu qayda sonsuz yönləndirmə yaradır).
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Admin panel öz giriş faylı ilə işləyir.
    RewriteRule ^admin$ admin/ [R=301,L]
    RewriteRule ^admin/$ admin/index.php [L]

    # Mövcud fayllar birbaşa, qalan hər şey index.php-yə.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml application/json
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
